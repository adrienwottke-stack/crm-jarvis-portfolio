# Supabase Postgres – Transaction Pooler (Port 6543), wird von der App genutzt
DATABASE_URL="postgresql://postgres.<project-ref>:<passwort>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Optional: maximale Verbindungen je App-Prozess (Standard: 10).
DATABASE_POOL_MAX="10"

# Supabase Postgres – Session Pooler (Port 5432), nur für Prisma-Migrationen.
# Muss auch in Vercel gesetzt sein: der Build startet mit "prisma migrate deploy".
DIRECT_URL="postgresql://postgres.<project-ref>:<passwort>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Nur für die einmalige Anlage des ersten Admin-Kontos. Danach meldet sich der
# Admin mit seiner E-Mail-Adresse und diesem Passwort an.
APP_PASSWORD="REPLACE_WITH_YOUR_OWN_VALUE"

# Zufälliges, langes Geheimnis zum Signieren persönlicher Sitzungen.
# In Produktion unbedingt setzen; mindestens 32 zufällige Zeichen verwenden.
SESSION_SECRET="REPLACE_WITH_YOUR_OWN_VALUE"

# Web-Push (Meldungen). Schlüsselpaar erzeugen mit:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Ohne diese Werte läuft die App vollständig – nur ohne Meldungen.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:du@example.com"

# Schützt /api/cron/meldungen. In Vercel setzen; der Cron-Lauf steht in vercel.json.
CRON_SECRET="REPLACE_WITH_YOUR_OWN_VALUE"

# Belegmail zum Auftragsverarbeitungsvertrag (lib/avv/mail.ts).
# Ohne diese Werte laeuft die App vollstaendig - die Zustimmung wird
# gespeichert, nur die PDF-Mail bleibt aus. Der Versand darf einen
# rechtlichen Vorgang nie zurueckdrehen.
RESEND_API_KEY="REPLACE_WITH_YOUR_OWN_VALUE"
AVV_MAIL_FROM=Cockpit <noreply@example.de>

# Schluessel fuer die Zugangsdaten angebundener Kalender (lib/crypto.ts).
# AES-256-GCM, mindestens 32 Zeichen. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# ACHTUNG, anders als SESSION_SECRET: hiermit werden Passwoerter UMKEHRBAR
# verschluesselt, nicht gehasht - TimeTree hat seine Schnittstelle 2023
# abgeschaltet, und die verbliebene Anmeldung verlangt das Passwort im
# Klartext. Wer Datenbank UND diesen Schluessel hat, hat die TimeTree-
# Passwoerter. Wird der Schluessel gewechselt, sind alle gespeicherten
# Zugaenge unlesbar und muessen neu eingegeben werden.
#
# Ohne diesen Wert laeuft die App vollstaendig - nur das Anbinden fremder
# Kalender ist gesperrt und sagt das auf der Seite auch.
KALENDER_SECRET="REPLACE_WITH_YOUR_OWN_VALUE"

# --- AI CRM Add-on ----------------------------------------------------------
# Globaler Not-Aus. Ohne true bleibt AI CRM auch fuer Beta- und Abo-Konten zu.
AI_CRM_ENABLED=false

# OpenAI: serverseitig, niemals als NEXT_PUBLIC_-Variable setzen.
OPENAI_API_KEY="REPLACE_WITH_YOUR_OWN_VALUE"
AI_MODEL=gpt-4o-mini
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Verkaufspreis fuer Anzeige und Stripe-Preispruefung (Cent, hier 15 EUR).
# Der Stripe Price muss aktiv, monatlich, in EUR und exakt gleich hoch sein.
AI_CRM_PRICE_CENTS=1500

# Fair-Use je Nutzer und Berliner Kalendermonat.
AI_MAX_MONTHLY_REQUESTS=300
AI_MAX_MONTHLY_AUDIO_SECONDS=3600
AI_MAX_MONTHLY_TOOL_CALLS=1500
AI_MAX_TOOL_ROUNDS=6
AI_MAX_AUDIO_BYTES=5242880
AI_MAX_AUDIO_SECONDS=60
AI_CONVERSATION_RETENTION_DAYS=7
AI_CONVERSATION_MAX_MESSAGES=20
AI_PROVIDER_TIMEOUT_MS=45000
AI_PROVIDER_MAX_RETRIES=1
STRIPE_PROVIDER_TIMEOUT_MS=20000
STRIPE_PROVIDER_MAX_RETRIES=1

# Jarvis Live: bewusst deaktiviert; echter Pilot mit live, Simulation mit mock.
# `mock` ist nur fuer eine bewusst lokale/Test-Session gedacht. In Production
# wird ein versehentliches `mock` serverseitig zu `disabled` erzwungen.
# Der echte Realtime-Pfad bleibt bis zur expliziten Freigabe und einer
# serverseitig betriebenen Sideband-Verbindung fail-closed.
AI_LIVE_PROVIDER=disabled
AI_LIVE_MODEL=gpt-live-1
AI_LIVE_MAX_SESSION_SECONDS=600
AI_LIVE_RECONNECT_LIMIT=1
AI_LIVE_REALTIME_APPROVED=false
AI_LIVE_SIDEBAND_URL=
# Stimmenvergleich vor Sitzungsstart: vesper, meridian, cinder, cedar, ash.
AI_LIVE_VOICE=meridian
AI_LIVE_SPEECH_MODEL=gpt-4o-mini-tts
# Nach Migration 20260927140000: Zugriffe je Chat (Nur lesen / Bestätigen / Selbstständig).
# Ohne diese Freigabe bleiben neue und bestehende Anfragen im Bestätigungsmodus.
AI_CRM_EXECUTION_MODES=true
JARVIS_DEMO_ENABLED=false
JARVIS_GREETING_NAME=Meister Emil
AI_LIVE_INACTIVITY_SECONDS=120
AI_LIVE_WARNING_SECONDS=15
AI_LIVE_MAX_TURNS=30
# Freigegebene lokale Datei ausserhalb des Repositorys; kein automatischer Download.
AI_LIVE_MUSIC_FILE=
AI_LIVE_MUSIC_TITLE=
# Production: private Vercel Blob object. Never a public URL. Local file takes precedence.
AI_LIVE_MUSIC_BLOB_PATH=
# Connected private store; Vercel supplies and refreshes VERCEL_OIDC_TOKEN automatically.
BLOB_STORE_ID=

# Spotify hat zwei strikt getrennte Modi. Aktiviere niemals beide zugleich.
# Lokaler Smoke: nur eine lokale 127.0.0.1/[::1]-Datenbank ist zulässig; der
# Smoke-Runner setzt sie deshalb für seinen flüchtigen PGlite-Prozess. Spotify
# akzeptiert hierfür kein "localhost": Port und Callback-Pfad müssen exakt mit
# dem Spotify Developer Dashboard übereinstimmen.
SPOTIFY_LOCAL_ENABLED=false
# Hosted OAuth: ausschließlich als Production-Variable bei Vercel setzen.
# Preview darf SPOTIFY_ENABLED nie erhalten. In Production müssen APP_URL und
# Redirect exakt dieselbe HTTPS-Origin haben, z. B. https://ergo-crm.vercel.app.
SPOTIFY_ENABLED=false
SPOTIFY_APP_URL=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET="REPLACE_WITH_YOUR_OWN_VALUE"
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3132/api/ai-crm/music/spotify/callback
# Separater AES-256-GCM-Schluessel fuer Spotify-Refresh-Tokens, mindestens
# 32 Zeichen; nie mit NEXT_PUBLIC_ beginnen und nie in das Repository schreiben.
SPOTIFY_TOKEN_SECRET="REPLACE_WITH_YOUR_OWN_VALUE"

# Optionale Kostenschaetzung. Rohdaten werden auch bei 0 gespeichert.
# Werte sind Mikro-Waehrungseinheiten (1 USD = 1.000.000) je 1 Mio. Tokens
# beziehungsweise je Audiominute. Vor Production mit den aktuellen Provider-
# Preisen fuellen; nicht aus altem Beispielmaterial uebernehmen.
AI_COST_CURRENCY=USD
AI_COST_INPUT_MICROS_PER_MILLION_TOKENS="REPLACE_WITH_YOUR_OWN_VALUE"
AI_COST_OUTPUT_MICROS_PER_MILLION_TOKENS="REPLACE_WITH_YOUR_OWN_VALUE"
AI_COST_AUDIO_MICROS_PER_MINUTE=0

# Stripe Billing. STRIPE_AI_PRICE_ID verweist auf genau einen monatlichen
# Recurring Price; Checkout verifiziert Betrag, Waehrung und Intervall.
STRIPE_SECRET_KEY="REPLACE_WITH_YOUR_OWN_VALUE"
STRIPE_AI_PRICE_ID=
STRIPE_WEBHOOK_SECRET="REPLACE_WITH_YOUR_OWN_VALUE"

# Oeffentliche Basis-URL fuer Checkout-Rueckkehr und Customer Portal.
# Lokal z. B. http://localhost:3000, in Production die kanonische HTTPS-URL.
APP_URL=http://localhost:3000
